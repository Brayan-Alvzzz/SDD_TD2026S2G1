{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PasswordRecoveryAPI",
  "description": "Contrato de interfaz para solicitud y confirmación de restablecimiento de contraseña (HU-14)",
  "version": "2.0.0",
  "endpoints": {
    "request_reset": {
      "path": "/forgot-password",
      "method": "POST",
      "description": "Solicita un enlace de restablecimiento de contraseña para un correo electrónico",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded o application/json"
      },
      "request_body": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Dirección de correo electrónico asociada a la cuenta"
          }
        }
      },
      "responses": {
        "200": {
          "description": "Respuesta neutra invariable (mitigación de enumeración de usuarios)",
          "body": {
            "type": "object",
            "required": ["status", "message"],
            "properties": {
              "status": { "type": "string", "enum": ["success"] },
              "message": {
                "type": "string",
                "enum": ["Si la dirección de correo electrónico está registrada en el sistema, se ha enviado un enlace para restablecer la contraseña."]
              }
            }
          }
        },
        "400": {
          "description": "Error de validación sintáctica del correo ingresado",
          "body": {
            "type": "object",
            "required": ["status", "message"],
            "properties": {
              "status": { "type": "string", "enum": ["error"] },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "confirm_reset": {
      "path": "/reset-password/{token}",
      "method": "POST",
      "description": "Aplica una nueva contraseña utilizando un token válido y no expirado",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded o application/json"
      },
      "parameters": {
        "token": {
          "type": "string",
          "description": "Token aleatorio de un solo uso recibido en la terminal/enlace"
        }
      },
      "request_body": {
        "type": "object",
        "required": ["password", "password_confirm"],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Nueva contraseña (mínimo 8 caracteres)"
          },
          "password_confirm": {
            "type": "string",
            "minLength": 8,
            "description": "Confirmación de la nueva contraseña"
          }
        }
      },
      "responses": {
        "200": {
          "description": "Contraseña actualizada exitosamente",
          "body": {
            "type": "object",
            "required": ["status", "message"],
            "properties": {
              "status": { "type": "string", "enum": ["success"] },
              "message": {
                "type": "string",
                "enum": ["Contraseña actualizada exitosamente. Ya puede iniciar sesión."]
              }
            }
          }
        },
        "302": {
          "description": "En interacción web tradicional, redirección a /login con flash message de confirmación"
        },
        "400": {
          "description": "Token inválido, expirado, reutilizado, o contraseñas no coincidentes / menores a 8 caracteres",
          "body": {
            "type": "object",
            "required": ["status", "message"],
            "properties": {
              "status": { "type": "string", "enum": ["error"] },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
